---
import BaseLayout from './BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  category?: string;
  tags?: string[];
  destination?: string;
}

const { title, description, pubDate, updatedDate, heroImage, category, tags = [], destination } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedFormatted = updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const isVideo = heroImage && /\.(mp4|MOV|webm)$/i.test(heroImage);
---

<BaseLayout title={title} description={description} image={heroImage}>
  <article>
    {heroImage && (
      <div class="w-full h-[50vh] lg:h-[65vh] overflow-hidden">
        {isVideo ? (
          <video
            src={heroImage}
            autoplay
            loop
            muted
            playsinline
            class="w-full h-full object-cover"
          />
        ) : (
          <img
            src={heroImage}
            alt={title}
            class="w-full h-full object-cover"
          />
        )}
      </div>
    )}

    <div class="max-w-3xl mx-auto px-6 lg:px-8 py-12 lg:py-16">
      <header class="mb-10">
        {category && (
          <span class="text-[11px] uppercase tracking-[0.2em] text-wine font-medium">{category}</span>
        )}
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-semibold text-plum mt-2 mb-4 leading-[1.1]">
          {title}
        </h1>
        <p class="font-heading text-lg lg:text-xl text-espresso/50 italic mb-6">{description}</p>
        <div class="flex items-center gap-3 text-xs text-espresso/40">
          <time>{formattedDate}</time>
          {destination && (
            <>
              <span>&middot;</span>
              <span>{destination}</span>
            </>
          )}
          {updatedFormatted && (
            <span class="text-espresso/30">(Updated {updatedFormatted})</span>
          )}
        </div>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {tags.map(tag => (
              <span class="text-[10px] uppercase tracking-[0.15em] text-espresso/40 border border-espresso/15 px-3 py-1 rounded-sm">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="prose">
        <slot />
      </div>

      <div class="mt-16 pt-10 border-t border-lavender/30">
        <Newsletter />
      </div>
    </div>
  </article>
</BaseLayout>
