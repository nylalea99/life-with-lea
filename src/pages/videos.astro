---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';

const videos = [
  {
    url: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ',
    title: 'Welcome to My Channel',
    description: 'An introduction to Life with Lea and what to expect.',
  },
  {
    url: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ',
    title: 'My Favorite Kitchen Tips',
    description: 'Simple kitchen hacks that make cooking easier every day.',
  },
  {
    url: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ',
    title: 'Morning Routine for a Productive Day',
    description: 'How I start my mornings to set myself up for success.',
  },
  {
    url: 'https://vimeo.com/76979871',
    title: 'A Day in My Life',
    description: 'Come along for a full day in my life.',
  },
];
---

<BaseLayout title="Videos" description="Watch videos on recipes, lifestyle, and more.">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <header class="mb-12">
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">Videos</h1>
      <p class="text-gray-600 text-lg">Watch along for recipes, lifestyle content, and more.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {videos.map(video => (
        <div>
          <VideoEmbed url={video.url} title={video.title} />
          <div class="mt-4">
            <h3 class="font-heading text-lg font-bold">{video.title}</h3>
            <p class="text-gray-600 text-sm mt-1">{video.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
