---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map(course => ({
    params: { slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);
---

<BaseLayout title={course.data.title} description={course.data.description} image={course.data.heroImage}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    {course.data.heroImage && (
      <img
        src={course.data.heroImage}
        alt={course.data.title}
        class="w-full h-64 md:h-96 object-cover rounded-2xl mb-8"
      />
    )}

    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class:list={[
          'text-sm font-bold px-4 py-1.5 rounded-full',
          course.data.isPaid ? 'bg-brand-primary text-white' : 'bg-brand-teal text-white'
        ]}>
          {course.data.isPaid ? `$${course.data.price}` : 'Free'}
        </span>
        <span class="text-sm text-gray-500">{course.data.lessons} lessons</span>
      </div>
      <h1 class="font-heading text-3xl md:text-4xl font-bold mb-4">{course.data.title}</h1>
      <p class="text-gray-600 text-lg">{course.data.description}</p>
    </header>

    {course.data.isPaid && (
      <div class="bg-brand-light rounded-2xl p-6 border border-black/5 mb-8">
        <h3 class="font-heading text-xl font-bold mb-2">Unlock this Course</h3>
        <p class="text-gray-600 mb-4">Get lifetime access to all {course.data.lessons} lessons for ${course.data.price}.</p>
        <button class="bg-brand-primary hover:bg-brand-coral text-white font-semibold px-8 py-3 rounded-full transition">
          Enroll Now &mdash; ${course.data.price}
        </button>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
