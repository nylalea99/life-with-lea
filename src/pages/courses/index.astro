---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses'));
const freeCourses = courses.filter(c => !c.data.isPaid);
const paidCourses = courses.filter(c => c.data.isPaid);
---

<BaseLayout title="Courses" description="Learn at your own pace with free and premium courses.">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <header class="mb-12">
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">Courses</h1>
      <p class="text-gray-600 text-lg">Learn at your own pace. Choose from free and premium courses.</p>
    </header>

    {freeCourses.length > 0 && (
      <div class="mb-16">
        <h2 class="font-heading text-2xl font-bold mb-6 text-brand-teal">Free Courses</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {freeCourses.map(course => (
            <CourseCard
              title={course.data.title}
              description={course.data.description}
              href={`/courses/${course.id}`}
              image={course.data.heroImage}
              isPaid={course.data.isPaid}
              price={course.data.price}
              lessons={course.data.lessons}
              tags={course.data.tags}
            />
          ))}
        </div>
      </div>
    )}

    {paidCourses.length > 0 && (
      <div>
        <h2 class="font-heading text-2xl font-bold mb-6 text-brand-primary">Premium Courses</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {paidCourses.map(course => (
            <CourseCard
              title={course.data.title}
              description={course.data.description}
              href={`/courses/${course.id}`}
              image={course.data.heroImage}
              isPaid={course.data.isPaid}
              price={course.data.price}
              lessons={course.data.lessons}
              tags={course.data.tags}
            />
          ))}
        </div>
      </div>
    )}

    {courses.length === 0 && (
      <p class="text-gray-500 text-center py-12">Courses coming soon! Stay tuned.</p>
    )}
  </section>
</BaseLayout>
