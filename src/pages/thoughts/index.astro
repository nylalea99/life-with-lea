---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const thoughts = (await getCollection('thoughts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Thoughts" description="Reflections and thoughts on life.">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <header class="mb-12">
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">Thoughts on Life</h1>
      <p class="text-gray-600 text-lg">Reflections, musings, and lessons learned along the way.</p>
    </header>

    {thoughts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {thoughts.map(thought => (
          <ContentCard
            title={thought.data.title}
            description={thought.data.description}
            href={`/thoughts/${thought.id}`}
            date={thought.data.pubDate}
          />
        ))}
      </div>
    ) : (
      <p class="text-gray-500 text-center py-12">Coming soon! Stay tuned for reflections.</p>
    )}
  </section>
</BaseLayout>
