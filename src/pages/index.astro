---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import DestinationCard from '../components/DestinationCard.astro';
import HandwrittenNote from '../components/HandwrittenNote.astro';
import QuoteSection from '../components/QuoteSection.astro';
import Newsletter from '../components/Newsletter.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getCollection } from 'astro:content';

const allPosts = [
  ...(await getCollection('go')),
  ...(await getCollection('eat-drink')),
  ...(await getCollection('live')),
  ...(await getCollection('think')),
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts.slice(0, 4);

const destinations = [
  { title: 'Portugal', image: 'https://images.unsplash.com/photo-1555881400-74d7acaacd8b?w=800&q=80', href: '/go', description: 'Lisbon streets & coastal mornings' },
  { title: 'South Africa', image: 'https://images.unsplash.com/photo-1516426122078-c23e76319801?w=800&q=80', href: '/go', description: 'Bush sunsets & wine farm afternoons' },
  { title: 'The Cape', image: 'https://images.unsplash.com/photo-1580060839134-75a5edca2e99?w=800&q=80', href: '/go', description: 'Mountains, oceans & everything between' },
  { title: 'Europe', image: 'https://images.unsplash.com/photo-1467269204594-9661b134dd2b?w=800&q=80', href: '/go', description: 'Hidden gems & weekend escapes' },
];
---

<BaseLayout title="Home" description="A South African in Portugal collecting places, food, thoughts and little moments worth remembering. Wild places, good coffee, great wine.">
  <!-- Hero Slideshow -->
  <section class="relative h-[85vh] lg:h-screen overflow-hidden">
    <div class="hero-slideshow">
      <img src="/images/IMG_8001.jpg" alt="" class="hero-slide" />
      <img src="/images/IMG_7620.jpg" alt="" class="hero-slide" />
      <img src="/images/IMG_4626.jpg" alt="" class="hero-slide" />
      <img src="/images/IMG_9891.jpg" alt="" class="hero-slide" />
      <img src="/images/IMG_6685.jpg" alt="" class="hero-slide" />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-blackberry/30 via-blackberry/10 to-cream"></div>
    <div class="absolute inset-0 flex items-end pb-16 lg:pb-24 px-6 lg:px-8">
      <div class="max-w-7xl mx-auto w-full">
        <p class="font-script text-2xl lg:text-3xl text-cream/80 mb-3 -rotate-1">coffee first.</p>
        <h1 class="font-heading text-4xl md:text-5xl lg:text-7xl font-semibold text-cream leading-[1.05] max-w-3xl mb-6">
          Wild places, good coffee, great wine & everything in between.
        </h1>
        <a href="/go" class="inline-flex items-center gap-2 text-cream/90 text-sm font-medium tracking-wide border-b border-cream/40 pb-1 hover:border-cream transition-colors duration-300">
          Explore <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-2">
        <div class="aspect-[3/4] rounded-sm overflow-hidden">
          <img
            src="/images/IMG_9891.jpg"
            alt="Lea"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <div class="lg:col-span-3">
        <h2 class="font-heading text-4xl lg:text-5xl font-semibold text-plum mb-6">Hi, I'm Lea.</h2>
        <p class="text-espresso/70 text-lg leading-relaxed mb-4 max-w-xl">
          Somewhere between Portugal and the South African bush, usually looking for good coffee,
          a beautiful place to walk, and an excuse to order the wine.
        </p>
        <p class="text-espresso/70 text-lg leading-relaxed mb-6 max-w-xl">
          Life with Lea is where I keep the places, thoughts and little things I want to remember.
        </p>
        <HandwrittenNote text="worth the detour →" />
      </div>
    </div>
  </section>

  <!-- Four Worlds -->
  <section class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-24">
    <SectionHeading title="Four worlds, one life." />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10">
      <CategoryCard
        title="Go"
        description="Travel guides, hidden gems, hikes and weekend getaways."
        href="/go"
        image="https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=600&q=80"
        cta="Explore Go"
      />
      <CategoryCard
        title="Eat & Drink"
        description="Coffee shops, restaurants, wine farms and things worth ordering twice."
        href="/eat-drink"
        image="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=600&q=80"
        cta="Explore Eat & Drink"
      />
      <CategoryCard
        title="Live"
        description="Life in your twenties, routines, home and the little things."
        href="/live"
        image="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=600&q=80"
        cta="Explore Live"
      />
      <CategoryCard
        title="Think"
        description="Thoughts about creativity, career and figuring things out."
        href="/think"
        image="https://images.unsplash.com/photo-1432821596592-e2c18b78144f?w=600&q=80"
        cta="Explore Think"
      />
    </div>
  </section>

  <!-- Featured Stories -->
  <section class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-24">
    <SectionHeading title="Latest from Lea" subtitle="Stories, guides and thoughts worth reading." />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {featured.map((post, i) => (
        <ArticleCard
          title={post.data.title}
          description={post.data.description}
          href={`/${post.collection}/${post.id}`}
          date={post.data.pubDate}
          category={post.data.category}
          image={post.data.heroImage}
          destination={post.data.destination}
          featured={i === 0}
        />
      ))}
    </div>
    <div class="text-center mt-12">
      <HandwrittenNote text="Lea loved this one" />
    </div>
  </section>

  <!-- Travel Feature -->
  <section class="bg-mauve/20 py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <SectionHeading title="Places worth the detour." subtitle="Destinations that left a mark." align="center" />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {destinations.map(dest => (
          <DestinationCard
            title={dest.title}
            image={dest.image}
            href={dest.href}
            description={dest.description}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Quote -->
  <QuoteSection />

  <!-- Newsletter -->
  <Newsletter />
</BaseLayout>
