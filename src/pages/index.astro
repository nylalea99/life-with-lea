---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import CourseCard from '../components/CourseCard.astro';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recipes = (await getCollection('recipes')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const thoughts = (await getCollection('thoughts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const courses = (await getCollection('courses'));

const latestBlog = blogPosts.slice(0, 2);
const latestRecipes = recipes.slice(0, 2);
const latestThoughts = thoughts.slice(0, 2);
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-dark via-brand-secondary to-brand-dark text-white py-20 md:py-32">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h1 class="font-heading text-4xl md:text-6xl font-bold mb-6">
        Welcome to <span class="text-brand-accent">Life with Lea</span>
      </h1>
      <p class="text-lg md:text-xl text-white/80 mb-8 max-w-2xl mx-auto">
        Recipes, thoughts on life, videos, and courses to help you live your most vibrant, intentional life.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/recipes" class="bg-brand-primary hover:bg-brand-coral text-white font-semibold px-8 py-3 rounded-full transition">
          Explore Recipes
        </a>
        <a href="/courses" class="bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3 rounded-full transition border border-white/20">
          Browse Courses
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  {latestBlog.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="font-heading text-2xl md:text-3xl font-bold">Latest from the Blog</h2>
        <a href="/blog" class="text-brand-primary hover:text-brand-secondary text-sm font-semibold transition">View all &rarr;</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {latestBlog.map(post => (
          <ContentCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}`}
            date={post.data.pubDate}
            tags={post.data.tags}
            image={post.data.heroImage}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Latest Recipes -->
  {latestRecipes.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16 bg-brand-light/50">
      <div class="flex items-center justify-between mb-8">
        <h2 class="font-heading text-2xl md:text-3xl font-bold">Fresh Recipes</h2>
        <a href="/recipes" class="text-brand-primary hover:text-brand-secondary text-sm font-semibold transition">View all &rarr;</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {latestRecipes.map(recipe => (
          <RecipeCard
            title={recipe.data.title}
            description={recipe.data.description}
            href={`/recipes/${recipe.id}`}
            image={recipe.data.heroImage}
            prepTime={recipe.data.prepTime}
            cookTime={recipe.data.cookTime}
            servings={recipe.data.servings}
            tags={recipe.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Latest Thoughts -->
  {latestThoughts.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="font-heading text-2xl md:text-3xl font-bold">Thoughts on Life</h2>
        <a href="/thoughts" class="text-brand-primary hover:text-brand-secondary text-sm font-semibold transition">View all &rarr;</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {latestThoughts.map(thought => (
          <ContentCard
            title={thought.data.title}
            description={thought.data.description}
            href={`/thoughts/${thought.id}`}
            date={thought.data.pubDate}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Courses -->
  {courses.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 py-16 bg-brand-light/50">
      <div class="flex items-center justify-between mb-8">
        <h2 class="font-heading text-2xl md:text-3xl font-bold">Courses</h2>
        <a href="/courses" class="text-brand-primary hover:text-brand-secondary text-sm font-semibold transition">View all &rarr;</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {courses.map(course => (
          <CourseCard
            title={course.data.title}
            description={course.data.description}
            href={`/courses/${course.id}`}
            image={course.data.heroImage}
            isPaid={course.data.isPaid}
            price={course.data.price}
            lessons={course.data.lessons}
            tags={course.data.tags}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
