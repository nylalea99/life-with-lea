---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog" description="Thoughts, stories, and insights from my life.">
  <section class="max-w-6xl mx-auto px-6 py-16">
    <header class="mb-12">
      <h1 class="font-heading text-4xl md:text-5xl font-bold mb-4">Blog</h1>
      <p class="text-gray-600 text-lg">Thoughts, stories, and insights from my everyday life.</p>
    </header>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map(post => (
          <ContentCard
            title={post.data.title}
            description={post.data.description}
            href={`/blog/${post.id}`}
            date={post.data.pubDate}
            tags={post.data.tags}
            image={post.data.heroImage}
          />
        ))}
      </div>
    ) : (
      <p class="text-gray-500 text-center py-12">Coming soon! Stay tuned for blog posts.</p>
    )}
  </section>
</BaseLayout>
