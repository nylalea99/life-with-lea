---
interface Props {
  title: string;
  image: string;
  href: string;
  description?: string;
}

const { title, image, href, description } = Astro.props;
---

<a href={href} class="group block relative overflow-hidden rounded-sm aspect-[3/4]">
  <img
    src={image}
    alt={title}
    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
    loading="lazy"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-blackberry/80 via-blackberry/20 to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-8">
    <h3 class="font-heading text-2xl lg:text-3xl font-semibold text-cream mb-1">{title}</h3>
    {description && (
      <p class="text-cream/70 text-sm">{description}</p>
    )}
  </div>
</a>
