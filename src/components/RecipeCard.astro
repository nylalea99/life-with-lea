---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  prepTime: number;
  cookTime: number;
  servings: number;
  tags?: string[];
}

const { title, description, href, image, prepTime, cookTime, servings, tags = [] } = Astro.props;
const totalTime = prepTime + cookTime;
---

<article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-black/5">
  {image && (
    <div class="aspect-[16/10] overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  )}
  <div class="p-6">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.slice(0, 2).map(tag => (
          <span class="text-xs font-medium bg-brand-teal/20 text-brand-teal px-2 py-1 rounded-full">{tag}</span>
        ))}
      </div>
    )}
    <h3 class="font-heading text-xl font-bold mb-2 group-hover:text-brand-primary transition">
      <a href={href}>{title}</a>
    </h3>
    <p class="text-gray-600 text-sm mb-4 line-clamp-2">{description}</p>
    <div class="flex items-center gap-4 text-xs text-gray-500">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {totalTime} min
      </span>
      <span>{servings} servings</span>
    </div>
  </div>
</article>
