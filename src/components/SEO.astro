---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { title, description = 'Places to go. Things to taste. Thoughts along the way.', image, type = 'website', pubDate } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : new URL('/images/IMG_9891.jpg', Astro.site).href;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonicalURL} />

<title>{title} | Life with Lea</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={`${title} | Life with Lea`} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Life with Lea" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} | Life with Lea`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{type === 'article' && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
  <meta property="article:author" content="Leandra Lopes" />
)}

<!-- Structured Data -->
{type === 'article' ? (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": ogImage,
    "author": { "@type": "Person", "name": "Leandra Lopes" },
    "publisher": { "@type": "Organization", "name": "Life with Lea", "url": Astro.site.href },
    "url": canonicalURL.href,
    "datePublished": pubDate?.toISOString()
  })} />
) : (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Life with Lea",
    "description": "Places to go. Things to taste. Thoughts along the way.",
    "url": Astro.site.href,
    "author": { "@type": "Person", "name": "Leandra Lopes" }
  })} />
)}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
