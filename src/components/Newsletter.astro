---

---

<section class="py-16 lg:py-20">
  <div class="max-w-xl mx-auto px-6 text-center">
    <p class="font-script text-2xl text-wine mb-2">a little note from Lea</p>
    <h3 class="font-heading text-2xl lg:text-3xl font-semibold text-plum mb-3">
      Worth the read
    </h3>
    <p class="text-espresso/70 text-sm mb-8">
      Places worth going, things worth tasting and a few thoughts along the way.
    </p>
    <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" action="#" method="post">
      <input
        type="email"
        name="email"
        placeholder="Your email address"
        required
        class="flex-1 px-5 py-3 rounded-sm bg-white border border-lavender/40 text-espresso text-sm placeholder:text-espresso/30 focus:outline-none focus:border-plum/50 transition"
      />
      <button
        type="submit"
        class="px-6 py-3 bg-plum text-cream text-sm font-medium rounded-sm hover:bg-wine transition-colors duration-300"
      >
        Send me the good stuff
      </button>
    </form>
  </div>
</section>
