---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  cta?: string;
}

const { title, description, href, image, cta } = Astro.props;
---

<a href={href} class="group block">
  {image && (
    <div class="aspect-[4/3] overflow-hidden rounded-sm mb-5">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
        loading="lazy"
      />
    </div>
  )}
  <h3 class="font-heading text-2xl lg:text-3xl font-semibold text-plum group-hover:text-wine transition-colors duration-300 mb-2">
    {title}
  </h3>
  <p class="text-espresso/80 text-sm leading-relaxed mb-3">{description}</p>
  {cta && (
    <span class="text-sm text-wine font-medium inline-flex items-center gap-1 group-hover:gap-2 transition-all duration-300">
      {cta} <span class="text-xs">&rarr;</span>
    </span>
  )}
</a>
