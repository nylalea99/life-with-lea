---
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  isPaid: boolean;
  price?: number;
  lessons: number;
  tags?: string[];
}

const { title, description, href, image, isPaid, price, lessons, tags = [] } = Astro.props;
---

<article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-black/5">
  {image && (
    <div class="aspect-[16/10] overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  )}
  <div class="p-6">
    <div class="flex items-center gap-2 mb-3">
      <span class:list={[
        'text-xs font-bold px-3 py-1 rounded-full',
        isPaid ? 'bg-brand-primary text-white' : 'bg-brand-teal text-white'
      ]}>
        {isPaid ? `$${price}` : 'Free'}
      </span>
      <span class="text-xs text-gray-500">{lessons} lessons</span>
    </div>
    <h3 class="font-heading text-xl font-bold mb-2 group-hover:text-brand-primary transition">
      <a href={href}>{title}</a>
    </h3>
    <p class="text-gray-600 text-sm line-clamp-2">{description}</p>
  </div>
</article>
