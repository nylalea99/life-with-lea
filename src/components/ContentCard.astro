---
interface Props {
  title: string;
  description: string;
  href: string;
  date: Date;
  tags?: string[];
  image?: string;
}

const { title, description, href, date, tags = [], image } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-black/5">
  {image && (
    <div class="aspect-[16/10] overflow-hidden">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    </div>
  )}
  <div class="p-6">
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.slice(0, 3).map(tag => (
          <span class="text-xs font-medium bg-brand-accent/20 text-brand-primary px-2 py-1 rounded-full">{tag}</span>
        ))}
      </div>
    )}
    <h3 class="font-heading text-xl font-bold mb-2 group-hover:text-brand-primary transition">
      <a href={href}>{title}</a>
    </h3>
    <p class="text-gray-600 text-sm mb-3 line-clamp-2">{description}</p>
    <time class="text-xs text-gray-400">{formattedDate}</time>
  </div>
</article>
