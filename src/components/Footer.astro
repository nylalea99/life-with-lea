---
const year = new Date().getFullYear();
---

<footer class="bg-blackberry text-cream/80 mt-24">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
      <div>
        <h3 class="font-heading text-3xl font-semibold text-cream mb-4">Life with Lea</h3>
        <p class="font-heading text-lg italic text-cream/70 mb-6">
          Places to go. Things to taste. Thoughts along the way.
        </p>
        <p class="text-sm leading-relaxed text-cream/50">
          A collection of places, thoughts & things worth remembering.
        </p>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] text-cream/60 mb-6">Explore</h4>
        <ul class="space-y-3">
          <li><a href="/go" class="text-sm hover:text-cream transition">Go</a></li>
          <li><a href="/eat-drink" class="text-sm hover:text-cream transition">Eat & Drink</a></li>
          <li><a href="/live" class="text-sm hover:text-cream transition">Live</a></li>
          <li><a href="/think" class="text-sm hover:text-cream transition">Think</a></li>
          <li><a href="/about" class="text-sm hover:text-cream transition">About</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs uppercase tracking-[0.2em] text-cream/60 mb-6">Connect</h4>
        <ul class="space-y-3">
          <li><a href="https://instagram.com/lovinglifewithlea" class="text-sm hover:text-cream transition" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="https://pinterest.com" class="text-sm hover:text-cream transition" target="_blank" rel="noopener">Pinterest</a></li>
          <li><a href="https://tiktok.com/@nylalea" class="text-sm hover:text-cream transition" target="_blank" rel="noopener">TikTok</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-cream/10 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-cream/60">&copy; {year} Life with Lea. All rights reserved.</p>
      <p class="font-script text-lg text-cream/60">See you somewhere beautiful.</p>
    </div>
  </div>
</footer>
