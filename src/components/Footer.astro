---
const year = new Date().getFullYear();
---

<footer class="bg-brand-dark text-white mt-16">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="font-heading text-xl font-bold text-brand-accent mb-4">Life with Lea</h3>
        <p class="text-white/60 text-sm leading-relaxed">
          Recipes, thoughts, videos, and courses to inspire your everyday life.
        </p>
      </div>

      <div>
        <h4 class="font-heading text-lg font-semibold mb-4">Explore</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/blog" class="text-white/60 hover:text-brand-accent transition">Blog</a></li>
          <li><a href="/recipes" class="text-white/60 hover:text-brand-accent transition">Recipes</a></li>
          <li><a href="/thoughts" class="text-white/60 hover:text-brand-accent transition">Thoughts</a></li>
          <li><a href="/videos" class="text-white/60 hover:text-brand-accent transition">Videos</a></li>
          <li><a href="/courses" class="text-white/60 hover:text-brand-accent transition">Courses</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-heading text-lg font-semibold mb-4">Connect</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="text-white/60 hover:text-brand-accent transition">About</a></li>
          <li><a href="mailto:hello@life-with-lea.com" class="text-white/60 hover:text-brand-accent transition">hello@life-with-lea.com</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-8 pt-8 text-center">
      <p class="text-white/40 text-sm">&copy; {year} Life with Lea. All rights reserved.</p>
    </div>
  </div>
</footer>
