---
interface Props {
  title: string;
  description: string;
  href: string;
  date: Date;
  category?: string;
  tags?: string[];
  image?: string;
  destination?: string;
  featured?: boolean;
}

const { title, description, href, date, category, tags = [], image, destination, featured = false } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<article class:list={['group', featured ? 'md:col-span-2' : '']}>
  <a href={href} class="block">
    {image && (
      <div class:list={['overflow-hidden rounded-sm', featured ? 'aspect-[16/9]' : 'aspect-[4/3]']}>
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
          loading="lazy"
        />
      </div>
    )}
    <div class:list={['mt-4', featured ? 'md:max-w-2xl' : '']}>
      {category && (
        <span class="text-[11px] uppercase tracking-[0.2em] text-wine font-medium">{category}</span>
      )}
      <h3 class:list={[
        'font-heading font-semibold text-plum mt-1 mb-2 group-hover:text-wine transition-colors duration-300',
        featured ? 'text-2xl lg:text-3xl' : 'text-xl lg:text-2xl',
      ]}>
        {title}
      </h3>
      <p class="text-espresso/80 text-sm leading-relaxed mb-3 line-clamp-2">{description}</p>
      <div class="flex items-center gap-3 text-xs text-espresso/60">
        <time>{formattedDate}</time>
        {destination && (
          <>
            <span>&middot;</span>
            <span>{destination}</span>
          </>
        )}
      </div>
    </div>
  </a>
</article>
