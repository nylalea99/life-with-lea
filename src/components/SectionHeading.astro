---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'left' } = Astro.props;
---

<div class:list={['mb-12', align === 'center' ? 'text-center' : '']}>
  <h2 class:list={[
    'font-heading text-3xl lg:text-4xl xl:text-5xl font-semibold text-plum',
    align === 'center' ? 'mb-4' : 'mb-3',
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class="text-espresso/50 text-base lg:text-lg max-w-xl" class:list={[align === 'center' ? 'mx-auto' : '']}>
      {subtitle}
    </p>
  )}
  <div class:list={[
    'w-12 h-[2px] bg-plum/30 mt-6',
    align === 'center' ? 'mx-auto' : '',
  ]}></div>
</div>
